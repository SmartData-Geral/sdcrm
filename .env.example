APP_NAME=SD CRM
APP_ENV=production
DEBUG=false

BACKEND_PORT=8082
FRONTEND_PORT=3001

DATABASE_URL=mysql+pymysql://usuario:senha@host:3306/sdcrm

JWT_SECRET_KEY=changeme-super-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOW_ORIGINS=https://smartdata.app.br

VITE_API_BASE_URL=/crm/api

MULTIEMPRESA_ENABLED=true

# Chave da OpenAI: use o .env na RAIZ do repositório (pasta sdcrm), não só no frontend.
# O backend carrega automaticamente esse arquivo mesmo se o uvicorn for iniciado de outra pasta.
LLM_PROVIDER=openai
LLM_OPENAI_API_KEY=
LLM_OPENAI_BASE_URL=
LLM_OPENAI_MODEL=gpt-4o-mini
# Timeout em segundos para cada chamada à API (rede lenta / texto grande).
LLM_HTTP_TIMEOUT_SECONDS=180
# Se precisar de proxy: defina também HTTP_PROXY e HTTPS_PROXY no sistema ou no .env (httpx usa).
LLM_MAX_FILE_SIZE_MB=10
LLM_MAX_FILES=5

