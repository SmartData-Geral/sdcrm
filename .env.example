APP_NAME=SD CRM
APP_ENV=production
DEBUG=false

BACKEND_PORT=8082
FRONTEND_PORT=3001

DATABASE_URL=mysql+pymysql://usuario:senha@host:3306/sdcrm

JWT_SECRET_KEY=changeme-super-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOW_ORIGINS=https://smartdata.app.br

# Diretório de uploads (opcional — padrão: /app/backend/uploads no container)
# Configure para apontar para um volume externo se necessário.
# SDCRM_UPLOADS_DIR=/data/uploads

VITE_API_BASE_URL=/crm/api

MULTIEMPRESA_ENABLED=true

# Chave da OpenAI: use o .env na RAIZ do repositório (pasta sdcrm), não só no frontend.
# O backend carrega automaticamente esse arquivo mesmo se o uvicorn for iniciado de outra pasta.
LLM_PROVIDER=openai
LLM_OPENAI_API_KEY=
LLM_OPENAI_BASE_URL=
LLM_OPENAI_MODEL=gpt-4o-mini
# Timeout em segundos para cada chamada à API (rede lenta / texto grande).
LLM_HTTP_TIMEOUT_SECONDS=180
# Se precisar de proxy: defina também HTTP_PROXY e HTTPS_PROXY no sistema ou no .env (httpx usa).
LLM_MAX_FILE_SIZE_MB=10
LLM_MAX_FILES=5


# --- Integração externa: API de entrada de leads + webhooks de saída ---
# Pepper da hash das chaves de API. Obrigatório quando APP_ENV=production.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ATENÇÃO: trocar este valor invalida TODAS as chaves de API já emitidas.
API_KEY_PEPPER=

# Onde o lead recebido pela API entra no funil.
LEADS_PIPELINE_PADRAO=default
LEADS_ETAPA_PADRAO_NOME=Novo Lead

# Cria automaticamente a origem em "Como conheceu" quando o `source` ainda não existe.
INTEGRACAO_AUTOCRIAR_ORIGEM=true

# Retenção do log de requisições da API (dias). Contém PII de lead - ver LGPD.
INTEGRACAO_LOG_RETENCAO_DIAS=90
# Grava e-mail/telefone sem máscara no log. Use só numa janela curta de depuração.
INTEGRACAO_LOG_PAYLOAD_COMPLETO=false

# --- Webhooks de saida (Fase 2) ---
# Desligue nas replicas de API se um dia extrair um container de worker dedicado.
WEBHOOK_WORKER_ENABLED=true
WEBHOOK_POLL_INTERVAL_SECONDS=10
WEBHOOK_BATCH_SIZE=20
WEBHOOK_TIMEOUT_SECONDS=15
# Desativa a assinatura apos N falhas seguidas (Zap abandonado).
WEBHOOK_MAX_FALHAS_DESATIVAR=20
WEBHOOK_RETENCAO_DIAS=30
# Lista separada por virgula. Vazio = qualquer host publico (faixas privadas sempre bloqueadas).
WEBHOOK_HOSTS_PERMITIDOS=
